# -----------------------------------------------------------
# Copiez ce fichier en ".env.local" et remplacez les valeurs.
# NE JAMAIS committer ".env.local" (il est ignore par git).
# -----------------------------------------------------------

# Mot de passe de l'espace administrateur (/admin)
ADMIN_PASSWORD=changez-moi-svp

# Lien Calendly (page Contact). Ex : https://calendly.com/kabarider/appel-decouverte
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/votre-compte/appel

# Adresse email de reception du formulaire de contact (optionnel, sinon affichage direct)
NEXT_PUBLIC_CONTACT_EMAIL=contact@kabareriders.com
NEXT_PUBLIC_CONTACT_PHONE=

# -----------------------------------------------------------
# Formulaire de contact qualifiant -> emails automatiques (Resend)
# Creer un compte sur https://resend.com, verifier le domaine kabareriders.com,
# puis generer une cle API. Voir GUIDE.md.
# -----------------------------------------------------------
# Cle API Resend (secrete, cote serveur uniquement)
RESEND_API_KEY=
# Adresse qui RECOIT les demandes du formulaire
EMAIL_CONTACT=kylian@kabareriders.com
# Adresse expediteur (doit appartenir au domaine verifie dans Resend)
EMAIL_FROM=Kabare Riders <contact@kabareriders.com>

# Reseaux sociaux (optionnel)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# URL publique du site (pour le SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://kabareriders.com

# Identifiants API HelloAsso (page Evenements - recuperation auto nom/date/lieu)
# A creer une fois sur https://admin.helloasso.com (Parametres > API), voir GUIDE.md
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=

# Stockage en ligne de l'admin. NE PAS remplir en local : cette variable est
# ajoutee AUTOMATIQUEMENT par Vercel quand vous connectez un store Blob (voir GUIDE.md).
# BLOB_READ_WRITE_TOKEN=
